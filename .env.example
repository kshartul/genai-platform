# Copy to .env for local runs against real clouds. Cloud deployments get these from Terraform outputs.
GENAI_PROFILE=profiles/knowledge-assistant.local.yaml
# AWS
AWS_REGION=ap-south-1
BEDROCK_CHAT_MODEL=
BEDROCK_FALLBACK_MODEL=
AOSS_ENDPOINT=
BEDROCK_GUARDRAIL_ID=
NEPTUNE_BOLT_URI=
# Azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_FALLBACK_DEPLOYMENT=chat-fallback
AZURE_OPENAI_EMBED_DEPLOYMENT=embed
AZURE_SEARCH_ENDPOINT=
NEO4J_URI=
# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
